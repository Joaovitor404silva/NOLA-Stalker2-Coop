out D:\modding\proofs\20261030_v130g_hostonly
up -Reuse -Calm -Dll D:\modding\cpp\wt\v130g\cppbuild\OutFast\NolaNative\NolaNative.dll -Save C:\modding\s2harness\testsave\scanner_20261030_host
setflag A downsecs 99999
setflag B downsecs 99999
