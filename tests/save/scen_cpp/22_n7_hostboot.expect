CMD role client
CMD flag csave 1
CMD flag n7 1
CMD flag n7sv 1
CMD flag n7eq 0
CMD flag qsync 1
CMD flag qrollback 1
CMD flag joinport 0
CMD flag kit 0
CMD flag n7early 1
CMD flag n7always 1
CMD flag leashown 1
CMD flag n7reboot 1
CMD t 1
CMD pawn 1000
CMD money 500
CMD peer up 1 1
CMD file B/client_applied.txt #S2CA 1 c6ad219ea28b4\nW\tc6ad219ea28b4\n3\tJ,q1,n1,go,s1\n
CMD file saved/STEAM/SaveGames/Data/11111111111111111111111111111111.sav AAAAAAAAAAAAAAAAAAAAAAAA-one
CMD file saved/STEAM/SaveGames/Data/22222222222222222222222222222222.sav BBBBBBBBBBBBBBBBBBBBBBBB-two
CMD part B 5,3,c6ad219ea28b4,0,0,3,abc
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
LOG NOLA csave: save do cliente carregado; 3 eventos do host ja estao nele (client_applied.txt)
LOG NOLA n7: host na sessao 1: cargas=0 saves=0 kh=3 geracao=5 pasta_de_saves=propria
LOG NOLA n7boot: o save carregado do cliente casa com o do host (campanha c6ad219ea28b4, 3 passos, host 3)
CMD t 3
CMD part B 5,3,c6ad219ea28b4,0,1,3,abc
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
LOG NOLA csave1: host salvou (#1, kh=3, campanha c6ad219ea28b4): o cliente salva agora
CMD t 22
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
STUB forcedAutoSave
LOG NOLA csave: XTriggerForcedAutoSave ok=true 
CMD stamp STEAM=2:2;NULL=-
CMD file saved/STEAM/SaveGames/Data/11111111111111111111111111111111.sav DDDDDDDDDDDDDDDDDDDDDDDDDDDD-one-saved
CMD t 24
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
CMD t 30
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
LOG NOLA csave: jogo do cliente salvo (arquivo de saves mudou); 3 eventos do host registrados como contidos nele
LOG NOLA csave1: save do cliente = par do save #1 do host (kh=3, campanha c6ad219ea28b4); o cliente tinha 3 passos aplicados
LOG NOLA n7sv: save do cliente 11111111 guarda 3 passos do host (par #1, 1 guardados) em 0,0,0
CMD t 31
CMD part J 4,J,q2,n2,go,s2|5,N,sid5
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
STUB quest J q2 n2 go s2 true
LOG NOLA quest: cliente seq=4 J q2 n2 go s2 -> true 
STUB quest N nil nil nil sid5 true
LOG NOLA quest: cliente seq=5 N nil nil nil sid5 -> true 
CMD nopart J
CMD t 33
CMD part J 6,J,q3,n3,go,s3
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
STUB quest J q3 n3 go s3 true
LOG NOLA quest: cliente seq=6 J q3 n3 go s3 -> true 
CMD nopart J
CMD t 35
CMD part B 5,6,c6ad219ea28b4,0,2,6,abc
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
LOG NOLA csave1: host salvou (#2, kh=6, campanha c6ad219ea28b4): o cliente salva agora
CMD t 55
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
STUB forcedAutoSave
LOG NOLA csave: XTriggerForcedAutoSave ok=true 
CMD stamp STEAM=3:3;NULL=-
CMD file saved/STEAM/SaveGames/Data/22222222222222222222222222222222.sav EEEEEEEEEEEEEEEEEEEEEEEEEEEE-two-saved
CMD t 57
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
CMD t 63
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
LOG NOLA csave: jogo do cliente salvo (arquivo de saves mudou); 6 eventos do host registrados como contidos nele
LOG NOLA csave1: save do cliente = par do save #2 do host (kh=6, campanha c6ad219ea28b4); o cliente tinha 6 passos aplicados
LOG NOLA n7sv: save do cliente 22222222 guarda 6 passos do host (par #2, 2 guardados) em 0,0,0
CMD t 70
CMD peer up 2 1
CMD part B 5,6,c6ad219ea28b4,0,2,-1,abc
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
LOG NOLA n7: host na sessao 2: cargas=0 saves=2 kh=nil geracao=5 pasta_de_saves=propria
LOG NOLA n7: host voltou em nova sessao 2 com o cliente no mundo: decisao de boot rearmada (6 passos aplicados aqui)
CMD t 71
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
CMD t 75
CMD part B 5,6,c6ad219ea28b4,0,2,3,abc
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
LOG NOLA n7boot: o save carregado do cliente tem 6 passos do host e o save do host so 3 (adiantado) -> carrego o save pareado 11111111 (3 passos do host, campanha c6ad219ea28b4)
LOG NOLA n7sv: host voltou ao save com 3 passos -> save pareado do cliente 11111111 (3 passos, par #1) copiado por cima do mais novo 22222222 (6 passos; copia em n7sv_backup.sav; 1 pares do ramo abandonado largados); XLoadLastSave carrega o pareado
STUB loadLastSave
LOG NOLA n7: host voltou no tempo -> retrato do cliente: 0 itens, dinheiro 500; XLoadLastSave ok=true 
CMD t 80
CMD part B 5,7,c6ad219ea28b4,0,3,3,abc
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
LOG NOLA csave1: host salvou (#3, kh=3, campanha c6ad219ea28b4): o cliente salva agora
CMD t 90
CMD tick
STUB lrDrop join_park parceiro de volta / descongelado
