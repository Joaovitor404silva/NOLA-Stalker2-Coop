h LOG NOLA TAKEN: 0 chaves lidas de taken.txt
h LOG NOLA lootshare: 0 corpos (DeadBody) em s2u_cont.tsv
c1 LOG NOLA lootshare: 0 corpos (DeadBody) em s2u_cont.tsv
c1 LOG NOLA LOCK_REQ BP_Box_C@520,30,1
c1 LOG NOLA LOCK_GRANT BP_Box_C@520,30,1
c1 LOG NOLA itake: 0 recipientes em s2u_cont.tsv
c1 LOG NOLA ptake: recipiente 60E63E8B813B51B0 aberto; inventario anotado
c1 LOG NOLA lscont: 0 recipientes em s2u_contk.tsv (arquivo ausente ou vazio: tento de novo em 30 s)
h LOG NOLA mc bau: BP_Box_C@520,30,1 dado ao pid 1 (primeiro a pedir)
c1 LOG NOLA lscont: primeiro a abrir o recipiente 60E63E8B813B51B0 (client): lista lida sem tirar nada: A012Ax30,Bandagex2
c1 LOG NOLA lscont: 60E63E8B813B51B0 igualado a lista comum na janela aberta (0 tiradas contadas; nada tirado do jogador, janela aberta): +[] -[]
h LOG NOLA TAKEN +lsl@60E63E8B813B51B0;c;A012Ax30,Bandagex2 (total 1)
h LOG NOLA lootshare: o cliente abriu primeiro o corpo 60E63E8B813B51B0: a lista dele vale para os dois
h LOG NOLA TAKEN +lsc@60E63E8B813B51B0;A012Ax30,Bandagex2 (total 2)
h LOG NOLA lootshare: lista comum do corpo 60E63E8B813B51B0: A012Ax30,Bandagex2 (minha copia sera igualada)
c1 LOG NOLA TAKEN +lsl@60E63E8B813B51B0;c;A012Ax30,Bandagex2 (total 1)
c1 LOG NOLA TAKEN +lsc@60E63E8B813B51B0;A012Ax30,Bandagex2 (total 2)
c1 LOG NOLA LOCK_REL BP_Box_C@520,30,1
c1 LOG NOLA TAKEN +ctake@60E63E8B813B51B0;c1001;A012Ax30 (total 3)
c1 LOG NOLA ptake: tirado do recipiente 60E63E8B813B51B0: A012Ax30
c1 LOG NOLA lootshare: lista comum do corpo 60E63E8B813B51B0: A012Ax30,Bandagex2 (minha copia ja e igual)
h LOG NOLA mc bau: BP_Box_C@520,30,1 solto pelo pid 1 (1.5 s)
h LOG NOLA TAKEN +ctake@60E63E8B813B51B0;c1001;A012Ax30 (total 3)
h LOG NOLA lscont: 0 recipientes em s2u_contk.tsv (arquivo ausente ou vazio: tento de novo em 30 s)
MARK t=c1-took-all-ammo
h LOG NOLA LOCK_REQ BP_Box_C@520,30,1
h LOG NOLA LOCK_GRANT BP_Box_C@520,30,1
h LOG NOLA itake: 0 recipientes em s2u_cont.tsv
h LOG NOLA ptake: recipiente 60E63E8B813B51B0 aberto; inventario anotado
h LOG NOLA mc bau: BP_Box_C@520,30,1 dado ao pid 0 (primeiro a pedir)
h STUB nput A012A -30 BP_Box_C_1
h STUB refresh
h LOG NOLA lscont: 60E63E8B813B51B0 igualado a lista comum na janela aberta (1 tiradas contadas; nada tirado do jogador, janela aberta): +[] -[A012Ax30]
MARK t=host-open
h INV BP_Box_C_1 Bandage*2
h INV BP_Stalker2Character_C_0
h LOG NOLA LOCK_REL BP_Box_C@520,30,1
h LOG NOLA TAKEN +ctake@60E63E8B813B51B0;h1001;Bandagex2 (total 4)
h LOG NOLA ptake: tirado do recipiente 60E63E8B813B51B0: Bandagex2
h LOG NOLA mc bau: BP_Box_C@520,30,1 solto pelo pid 0 (1.5 s)
c1 LOG NOLA TAKEN +ctake@60E63E8B813B51B0;h1001;Bandagex2 (total 4)
MARK t=host-took-rest
c1 LOG NOLA LOCK_REQ BP_Box_C@520,30,1
c1 LOG NOLA LOCK_GRANT BP_Box_C@520,30,1
c1 LOG NOLA ptake: recipiente 60E63E8B813B51B0 aberto; inventario anotado
h LOG NOLA mc bau: BP_Box_C@520,30,1 dado ao pid 1 (primeiro a pedir)
c1 STUB nput Bandage -2 BP_Box_C_1
c1 STUB refresh
c1 LOG NOLA lscont: recipiente 60E63E8B813B51B0 aberto de novo: 1 tiradas novas do outro jogador tiradas da minha copia na janela aberta (janela aberta): -[Bandagex2]
MARK t=c1-reopen
c1 INV BP_Box_C_1
c1 INV BP_Stalker2Character_C_0
c1 LOG NOLA LOCK_REL BP_Box_C@520,30,1
c1 LOG NOLA ptake: recipiente 60E63E8B813B51B0 fechado sem tirar nada
h LOG NOLA mc bau: BP_Box_C@520,30,1 solto pelo pid 1 (1.0 s)
