h LOG NOLA TAKEN: 0 chaves lidas de taken.txt
h LOG NOLA lootshare: 0 corpos (DeadBody) em s2u_cont.tsv
c1 LOG NOLA lootshare: 0 corpos (DeadBody) em s2u_cont.tsv
h LOG NOLA LOCK_REQ BP_Box_C@520,30,1
h LOG NOLA LOCK_GRANT BP_Box_C@520,30,1
h LOG NOLA itake: 0 recipientes em s2u_cont.tsv
h LOG NOLA ptake: recipiente 60E63E8B813B51B0 aberto; inventario anotado
h LOG NOLA lscont: 0 recipientes em s2u_contk.tsv (arquivo ausente ou vazio: tento de novo em 30 s)
h LOG NOLA mc bau: BP_Box_C@520,30,1 dado ao pid 0 (primeiro a pedir)
h LOG NOLA TAKEN +lsc@60E63E8B813B51B0;A012Ax30 (total 1)
h LOG NOLA lootshare: lista comum do corpo 60E63E8B813B51B0: A012Ax30 (minha copia ja e igual)
h LOG NOLA lscont: primeiro a abrir o recipiente 60E63E8B813B51B0 (host): lista lida sem tirar nada: A012Ax30
h LOG NOLA lscont: 60E63E8B813B51B0 igualado a lista comum na janela aberta (0 tiradas contadas; nada tirado do jogador, janela aberta): +[] -[]
c1 LOG NOLA TAKEN +lsc@60E63E8B813B51B0;A012Ax30 (total 1)
c1 LOG NOLA lootshare: lista comum do corpo 60E63E8B813B51B0: A012Ax30 (minha copia sera igualada)
MARK t=host-open
h LOG NOLA TAKEN +cput@60E63E8B813B51B0;c777;Medkitx1 (total 2)
h STUB nput Medkit 1 BP_Box_C_1
h STUB refresh
h LOG NOLA cdeposit: 60E63E8B813B51B0: chaves novas do outro jogador aplicadas na janela aberta: [+Medkitx1]
c1 LOG NOLA TAKEN +cput@60E63E8B813B51B0;c777;Medkitx1 (total 2)
MARK t=key-in
h INV BP_Box_C_1 A012A*30 Medkit*1
h LOG NOLA LOCK_REL BP_Box_C@520,30,1
h LOG NOLA TAKEN +ctake@60E63E8B813B51B0;h1001;Medkitx1 (total 3)
h LOG NOLA ptake: tirado do recipiente 60E63E8B813B51B0: Medkitx1
h LOG NOLA mc bau: BP_Box_C@520,30,1 solto pelo pid 0 (2.5 s)
c1 LOG NOLA TAKEN +ctake@60E63E8B813B51B0;h1001;Medkitx1 (total 3)
MARK t=host-closed
c1 LOG NOLA LOCK_REQ BP_Box_C@520,30,1
c1 LOG NOLA LOCK_GRANT BP_Box_C@520,30,1
c1 LOG NOLA itake: 0 recipientes em s2u_cont.tsv
c1 LOG NOLA ptake: recipiente 60E63E8B813B51B0 aberto; inventario anotado
c1 LOG NOLA lscont: 0 recipientes em s2u_contk.tsv (arquivo ausente ou vazio: tento de novo em 30 s)
h LOG NOLA mc bau: BP_Box_C@520,30,1 dado ao pid 1 (primeiro a pedir)
c1 LOG NOLA lscont: 60E63E8B813B51B0 igualado a lista comum na janela aberta (2 tiradas contadas; nada tirado do jogador, janela aberta): +[] -[]
MARK t=c1-open
c1 INV BP_Box_C_1 A012A*30
h MINE Medkit*1
c1 LOG NOLA LOCK_REL BP_Box_C@520,30,1
c1 LOG NOLA ptake: recipiente 60E63E8B813B51B0 fechado sem tirar nada
h LOG NOLA mc bau: BP_Box_C@520,30,1 solto pelo pid 1 (1.0 s)
