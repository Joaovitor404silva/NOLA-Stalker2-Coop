h LOG NOLA TAKEN: 0 chaves lidas de taken.txt
h LOG NOLA lootshare: 0 corpos (DeadBody) em s2u_cont.tsv
h LOG NOLA qshare: 0 marcas lidas de qshare_mine.txt (arquivo novo: as chaves que ja estao no livro agora contam como antigas)
h LOG NOLA qshare: inventario base lido (0 itens de missao, leitura nativa)
c1 LOG NOLA lootshare: 0 corpos (DeadBody) em s2u_cont.tsv
c1 LOG NOLA qshare: 0 marcas lidas de qshare_mine.txt (arquivo novo: as chaves que ja estao no livro agora contam como antigas)
c1 LOG NOLA qshare: inventario base lido (0 itens de missao, leitura nativa)
c1 LOG NOLA LOCK_REQ BP_Box_C@520,30,1
c1 LOG NOLA LOCK_GRANT BP_Box_C@520,30,1
c1 LOG NOLA itake: 1 recipientes em s2u_cont.tsv
c1 LOG NOLA ptake: recipiente AB12 aberto; inventario anotado
c1 LOG NOLA lscont: 1 recipientes em s2u_contk.tsv
h LOG NOLA mc bau: BP_Box_C@520,30,1 dado ao pid 1 (primeiro a pedir)
c1 LOG NOLA lscont: primeiro a abrir o recipiente AB12 (client): lista lida sem tirar nada: A012Ax5
c1 LOG NOLA lscont: AB12 igualado a lista comum na janela aberta (0 tiradas contadas; nada tirado do jogador, janela aberta): +[] -[]
h LOG NOLA TAKEN +lsl@AB12;c;A012Ax5 (total 1)
c1 LOG NOLA qshare: item de missao pego aqui: ANCQ01_VadaHvorostPDA x2 de cAB12 (agora 2); pedido ao host
c1 LOG NOLA qshare: item de missao pego aqui: EchoE01 x1 de cAB12 (agora 1); pedido ao host
h LOG NOLA TAKEN +qg@cAB12;ANCQ01_VadaHvorostPDA;2;2;c1.1 (total 2)
h LOG NOLA qshare: livro do host: ANCQ01_VadaHvorostPDA x2 de cAB12 pego por c1 (pid 1): os outros jogadores recebem pela criacao do jogo
h LOG NOLA TAKEN +qg@cAB12;EchoE01;1;1;c1.1 (total 3)
h LOG NOLA qshare: livro do host: EchoE01 x1 de cAB12 pego por c1 (pid 1): os outros jogadores recebem pela criacao do jogo
h STUB create ANCQ01_VadaHvorostPDA 0 2
h LOG NOLA qshare: ANCQ01_VadaHvorostPDA x2 de cAB12 pego por c1: eu tinha 0 -> +2 pela criacao do jogo
h STUB create EchoE01 0 1
h LOG NOLA qshare: EchoE01 x1 de cAB12 pego por c1: eu tinha 0 -> +1 pela criacao do jogo
c1 LOG NOLA TAKEN +lsl@AB12;c;A012Ax5 (total 1)
c1 LOG NOLA TAKEN +qg@cAB12;ANCQ01_VadaHvorostPDA;2;2;c1.1 (total 2)
c1 LOG NOLA TAKEN +qg@cAB12;EchoE01;1;1;c1.1 (total 3)
c1 LOG NOLA qshare: qg@cAB12;ANCQ01_VadaHvorostPDA;2;2;c1.1: eu mesmo peguei este item desta fonte: nada criado, nada tirado
c1 LOG NOLA qshare: qg@cAB12;EchoE01;1;1;c1.1: eu mesmo peguei este item desta fonte: nada criado, nada tirado
h LOG NOLA lootshare: o cliente abriu primeiro o corpo AB12: a lista dele vale para os dois
h LOG NOLA TAKEN +lsc@AB12;A012Ax5 (total 4)
h LOG NOLA lootshare: lista comum do corpo AB12: A012Ax5 (minha copia sera igualada)
c1 LOG NOLA TAKEN +lsc@AB12;A012Ax5 (total 4)
MARK t=c1-took
c1 LOG NOLA LOCK_REL BP_Box_C@520,30,1
c1 LOG NOLA TAKEN +ctake@AB12;c1001;A012Ax3 (total 5)
c1 LOG NOLA ptake: tirado do recipiente AB12: A012Ax3
h LOG NOLA mc bau: BP_Box_C@520,30,1 solto pelo pid 1 (1.5 s)
h LOG NOLA TAKEN +ctake@AB12;c1001;A012Ax3 (total 5)
h LOG NOLA lscont: 1 recipientes em s2u_contk.tsv
c1 LOG NOLA lootshare: lista comum do corpo AB12: A012Ax5 (minha copia ja e igual)
MARK t=granted
h MYQI ANCQ01_VadaHvorostPDA*2 EchoE01*1
c1 MYQI ANCQ01_VadaHvorostPDA*2 EchoE01*1
h INV BP_Box_C_1 A012A*5 ANCQ01_VadaHvorostPDA*2 EchoE01*1
h LOG NOLA LOCK_REQ BP_Box_C@520,30,1
h LOG NOLA LOCK_GRANT BP_Box_C@520,30,1
h LOG NOLA itake: 1 recipientes em s2u_cont.tsv
h LOG NOLA ptake: recipiente AB12 aberto; inventario anotado
h STUB nput ANCQ01_VadaHvorostPDA -2 BP_Box_C_1
h STUB refresh
h LOG NOLA qshare: ANCQ01_VadaHvorostPDA x2 tirado da minha copia de cAB12 (janela aberta; outro jogador ja pegou)
h STUB nput EchoE01 -1 BP_Box_C_1
h STUB refresh
h LOG NOLA qshare: EchoE01 x1 tirado da minha copia de cAB12 (janela aberta; outro jogador ja pegou)
h LOG NOLA mc bau: BP_Box_C@520,30,1 dado ao pid 0 (primeiro a pedir)
h STUB nput A012A -3 BP_Box_C_1
h STUB refresh
h LOG NOLA lscont: AB12 igualado a lista comum na janela aberta (1 tiradas contadas; nada tirado do jogador, janela aberta): +[] -[A012Ax3]
MARK t=host-opens-source
h INV BP_Box_C_1 A012A*2
