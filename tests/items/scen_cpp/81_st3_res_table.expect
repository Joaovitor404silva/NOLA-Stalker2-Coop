h LOG NOLA TAKEN: 0 chaves lidas de taken.txt
h LOG NOLA lootshare: 0 corpos (DeadBody) em s2u_cont.tsv
c1 LOG NOLA lootshare: 0 corpos (DeadBody) em s2u_cont.tsv
c1 LOG NOLA LOCK_REQ BP_Box_C@520,30,1
c1 LOG NOLA LOCK_GRANT BP_Box_C@520,30,1
c1 LOG NOLA itake: 1 recipientes em s2u_cont.tsv
c1 LOG NOLA ptake: recipiente AB12 aberto; inventario anotado
c1 LOG NOLA lscont: 1 recipientes em s2u_contk.tsv
h LOG NOLA mc bau: BP_Box_C@520,30,1 dado ao pid 1 (primeiro a pedir)
c1 LOG NOLA lscont: primeiro a abrir o recipiente AB12 (client): lista lida sem tirar nada: A012Ax30,Bandagex2
c1 LOG NOLA lscont: AB12 igualado a lista comum na janela aberta (0 tiradas contadas; nada tirado do jogador, janela aberta): +[] -[]
h LOG NOLA TAKEN +lsl@AB12;c;A012Ax30,Bandagex2 (total 1)
h LOG NOLA lootshare: o cliente abriu primeiro o corpo AB12: a lista dele vale para os dois
h LOG NOLA TAKEN +lsc@AB12;A012Ax30,Bandagex2 (total 2)
h LOG NOLA lootshare: lista comum do corpo AB12: A012Ax30,Bandagex2 (minha copia sera igualada)
c1 LOG NOLA TAKEN +lsl@AB12;c;A012Ax30,Bandagex2 (total 1)
c1 LOG NOLA TAKEN +lsc@AB12;A012Ax30,Bandagex2 (total 2)
c1 LOG NOLA LOCK_REL BP_Box_C@520,30,1
c1 LOG NOLA TAKEN +ctake@AB12;c1001;A012Ax30 (total 3)
c1 LOG NOLA ptake: tirado do recipiente AB12: A012Ax30
c1 LOG NOLA lootshare: lista comum do corpo AB12: A012Ax30,Bandagex2 (minha copia ja e igual)
h LOG NOLA mc bau: BP_Box_C@520,30,1 solto pelo pid 1 (1.5 s)
h LOG NOLA TAKEN +ctake@AB12;c1001;A012Ax30 (total 3)
h LOG NOLA lscont: 1 recipientes em s2u_contk.tsv
MARK t=c1-took-all-ammo
h LOG NOLA LOCK_REQ BP_Box_C@520,30,1
h LOG NOLA LOCK_GRANT BP_Box_C@520,30,1
h LOG NOLA itake: 1 recipientes em s2u_cont.tsv
h LOG NOLA ptake: recipiente AB12 aberto; inventario anotado
h LOG NOLA mc bau: BP_Box_C@520,30,1 dado ao pid 0 (primeiro a pedir)
h STUB nput A012A -30 BP_Box_C_1
h STUB refresh
h LOG NOLA lscont: AB12 igualado a lista comum na janela aberta (1 tiradas contadas; nada tirado do jogador, janela aberta): +[] -[A012Ax30]
MARK t=host-open
h INV BP_Box_C_1 Bandage*2
h INV BP_Stalker2Character_C_0
h LOG NOLA LOCK_REL BP_Box_C@520,30,1
h LOG NOLA TAKEN +ctake@AB12;h1001;Bandagex2 (total 4)
h LOG NOLA ptake: tirado do recipiente AB12: Bandagex2
h LOG NOLA mc bau: BP_Box_C@520,30,1 solto pelo pid 0 (1.5 s)
c1 LOG NOLA TAKEN +ctake@AB12;h1001;Bandagex2 (total 4)
c1 LOG NOLA itake: local C AB12 Bandage 2 -> true (2 nos na fila)
c1 LOG NOLA ptake: aplicado na minha copia: ctake@AB12;h1001;Bandagex2
c1 STUB node S2U_C_AB12_Bandage_1
c1 STUB node S2U_C_AB12_Bandage_1
c1 LOG NOLA itake: fila vazia
MARK t=host-took-rest
c1 LOG NOLA LOCK_REQ BP_Box_C@520,30,1
c1 LOG NOLA LOCK_GRANT BP_Box_C@520,30,1
c1 LOG NOLA ptake: recipiente AB12 aberto; inventario anotado
h LOG NOLA mc bau: BP_Box_C@520,30,1 dado ao pid 1 (primeiro a pedir)
MARK t=c1-reopen
c1 INV BP_Box_C_1 Bandage*2
c1 INV BP_Stalker2Character_C_0
c1 LOG NOLA LOCK_REL BP_Box_C@520,30,1
c1 LOG NOLA ptake: recipiente AB12 fechado sem tirar nada
h LOG NOLA mc bau: BP_Box_C@520,30,1 solto pelo pid 1 (1.0 s)
