h LOG NOLA TAKEN: 0 chaves lidas de taken.txt
h LOG NOLA lootshare: 0 corpos (DeadBody) em s2u_cont.tsv
c1 LOG NOLA lootshare: 0 corpos (DeadBody) em s2u_cont.tsv
c1 LOG NOLA LOCK_REQ BP_Box_C@520,30,1
c1 LOG NOLA LOCK_GRANT BP_Box_C@520,30,1
c1 LOG NOLA itake: 1 recipientes em s2u_cont.tsv
c1 LOG NOLA ptake: recipiente AB12 aberto; inventario anotado
c1 LOG NOLA lscont: 1 recipientes em s2u_contk.tsv
h LOG NOLA mc bau: BP_Box_C@520,30,1 dado ao pid 1 (primeiro a pedir)
c1 LOG NOLA lscont: primeiro a abrir o recipiente AB12 (client): lista lida sem tirar nada: A012Ax5
c1 LOG NOLA lscont: AB12 igualado a lista comum na janela aberta (0 tiradas contadas; nada tirado do jogador, janela aberta): +[] -[]
h LOG NOLA TAKEN +lsl@AB12;c;A012Ax5 (total 1)
c1 LOG NOLA TAKEN +lsl@AB12;c;A012Ax5 (total 1)
h LOG NOLA lootshare: o cliente abriu primeiro o corpo AB12: a lista dele vale para os dois
h LOG NOLA TAKEN +lsc@AB12;A012Ax5 (total 2)
h LOG NOLA lootshare: lista comum do corpo AB12: A012Ax5 (minha copia sera igualada)
c1 LOG NOLA TAKEN +lsc@AB12;A012Ax5 (total 2)
MARK t=c1-took
c1 LOG NOLA LOCK_REL BP_Box_C@520,30,1
c1 LOG NOLA TAKEN +ctake@AB12;c1001;A012Ax3 (total 3)
c1 LOG NOLA ptake: tirado do recipiente AB12: A012Ax3
h LOG NOLA mc bau: BP_Box_C@520,30,1 solto pelo pid 1 (1.5 s)
h LOG NOLA TAKEN +ctake@AB12;c1001;A012Ax3 (total 3)
h LOG NOLA lscont: 1 recipientes em s2u_contk.tsv
c1 LOG NOLA lootshare: lista comum do corpo AB12: A012Ax5 (minha copia ja e igual)
MARK t=granted
h MYQI
c1 MYQI ANCQ01_VadaHvorostPDA*2 EchoE01*1
h INV BP_Box_C_1 A012A*5 ANCQ01_VadaHvorostPDA*2 EchoE01*1
h LOG NOLA LOCK_REQ BP_Box_C@520,30,1
h LOG NOLA LOCK_GRANT BP_Box_C@520,30,1
h LOG NOLA itake: 1 recipientes em s2u_cont.tsv
h LOG NOLA ptake: recipiente AB12 aberto; inventario anotado
h LOG NOLA mc bau: BP_Box_C@520,30,1 dado ao pid 0 (primeiro a pedir)
h STUB nput A012A -3 BP_Box_C_1
h STUB refresh
h LOG NOLA lscont: AB12 igualado a lista comum na janela aberta (1 tiradas contadas; nada tirado do jogador, janela aberta): +[] -[A012Ax3]
MARK t=host-opens-source
h INV BP_Box_C_1 A012A*2 ANCQ01_VadaHvorostPDA*2 EchoE01*1
h MYQI
h LOG NOLA LOCK_REL BP_Box_C@520,30,1
h LOG NOLA ptake: recipiente AB12 fechado sem tirar nada
h LOG NOLA mc bau: BP_Box_C@520,30,1 solto pelo pid 0 (1.0 s)
MARK t=c1-rejoin
RESTART c1
c1 LOG NOLA lootshare: 0 corpos (DeadBody) em s2u_cont.tsv
c1 LOG NOLA TAKEN +ctake@AB12;c1001;A012Ax3 (total 1)
c1 LOG NOLA TAKEN +lsl@AB12;c;A012Ax5 (total 2)
c1 LOG NOLA TAKEN +lsc@AB12;A012Ax5 (total 3)
c1 LOG NOLA lscont: 1 recipientes em s2u_contk.tsv
c1 LOG NOLA lootshare: lista comum do corpo AB12: A012Ax5 (minha copia sera igualada)
c1 MYQI ANCQ01_VadaHvorostPDA*2 EchoE01*1
h MYQI
MARK t=host-reload
RESTART h
h LOG NOLA TAKEN: 3 chaves lidas de taken.txt
h LOG NOLA lootshare: o cliente abriu primeiro o corpo AB12: a lista dele vale para os dois
h LOG NOLA lootshare: lista comum do corpo AB12: A012Ax5 (minha copia sera igualada)
h LOG NOLA lootshare: 0 corpos (DeadBody) em s2u_cont.tsv
h MYQI
c1 MYQI ANCQ01_VadaHvorostPDA*2 EchoE01*1
MARK t=quest-used-it
RESTART h
h LOG NOLA TAKEN: 3 chaves lidas de taken.txt
h LOG NOLA lootshare: o cliente abriu primeiro o corpo AB12: a lista dele vale para os dois
h LOG NOLA lootshare: lista comum do corpo AB12: A012Ax5 (minha copia sera igualada)
h LOG NOLA lootshare: 0 corpos (DeadBody) em s2u_cont.tsv
h MYQI
MARK t=c1-level-change
c1 MYQI ANCQ01_VadaHvorostPDA*2 EchoE01*1
h MYQI
X1 h #K:#X:ctake@AB12;c1001;A012Ax3|lsl@AB12;c;A012Ax5|lsc@AB12;A012Ax5
